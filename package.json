  "type": "module",
  "bugs": {
    "url": "https://github.com/afeique/rainboids/issues"
  },
  "homepage": "https://github.com/afeique/rainboids#readme",
  "dependencies": {
    "http-server": "^14.1.1",
    "jsmediatags": "^3.9.7"
  },
  "devDependencies": {
    "vite": "^7.0.4"
  }
