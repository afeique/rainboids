# TLS termination + WebSocket-upgrade reverse proxy for the Rainboids MP server.
#
# Browsers must use wss:// when the page is served over https://. The Node
# server speaks plain ws:// on MP_PORT; nginx terminates TLS and upgrades.
# Clients then connect to wss://your-host/mp/ws.

upstream rainboids_mp {
    server 127.0.0.1:8091;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name your-host.example.com;

    ssl_certificate     /etc/letsencrypt/live/your-host.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-host.example.com/privkey.pem;

    # WebSocket endpoint — requires the Upgrade/Connection headers.
    location /mp/ws {
        proxy_pass http://rainboids_mp;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s; # don't drop idle-but-alive game sockets
    }

    # Liveness passthrough.
    location = /healthz {
        proxy_pass http://rainboids_mp;
    }
}
