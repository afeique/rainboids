upstream rainboids_ws {
    server 127.0.0.1:8443;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name play.rainboids.example;

    ssl_certificate     /etc/letsencrypt/live/play.rainboids.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/play.rainboids.example/privkey.pem;

    location /ws {
        proxy_pass http://rainboids_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout  600s;
        proxy_send_timeout  600s;
    }

    location /health  { proxy_pass http://rainboids_ws; }
    location /metrics { deny all; }
}
